# Copy this file to .env.local and fill in real local secrets.
# Never commit real credentials or secrets.

# Local PostgreSQL
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>"

# Auth
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 preferred secret name
AUTH_SECRET="GENERATE_A_32_PLUS_CHAR_SECRET"
# Backward-compatible alias (can be set to same value as AUTH_SECRET)
NEXTAUTH_SECRET="GENERATE_A_32_PLUS_CHAR_SECRET"

# @vercel/postgres-compatible variables (local)
POSTGRES_URL="postgresql://<user>:<password>@<host>:<port>/<database>"

# Contact form email (Resend)
RESEND_API_KEY="your-resend-api-key"
CONTACT_TO_EMAIL="recipient-email"
CONTACT_FROM_EMAIL="sender-email"

# QuickBooks OAuth token encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production; omit only in local development (tokens stored in plaintext).
QBO_TOKEN_ENCRYPTION_KEY="GENERATE_64_CHAR_HEX_STRING_HERE"
