# Copy this file to .env.local and fill in real local secrets.
# Never commit real credentials or secrets.

# Local PostgreSQL
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>:<port>/<database>"

# Auth
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 preferred secret name
AUTH_SECRET="<generate-a-long-random-secret>"
# Backward-compatible alias (can be set to same value as AUTH_SECRET)
NEXTAUTH_SECRET="<generate-a-long-random-secret>"

# Local PostgreSQL connection parts
PGHOST="localhost"
PGHOST_UNPOOLED="localhost"
PGUSER="<postgres-user>"
PGDATABASE="<database-name>"
PGPASSWORD="<postgres-password>"
PGPORT="5432"

# @vercel/postgres-compatible variables (local)
POSTGRES_URL="postgresql://<user>:<password>@<host>:<port>/<database>"
POSTGRES_URL_NON_POOLING="postgresql://<user>:<password>@<host>:<port>/<database>"
POSTGRES_USER="<postgres-user>"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="<postgres-password>"
POSTGRES_DATABASE="<database-name>"
POSTGRES_URL_NO_SSL="postgresql://<user>:<password>@<host>:<port>/<database>"
POSTGRES_PRISMA_URL="postgresql://<user>:<password>@<host>:<port>/<database>"
